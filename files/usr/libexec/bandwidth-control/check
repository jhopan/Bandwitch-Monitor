#!/bin/sh
set -u
STATE=${BC_STATE:-/etc/bandwidth-control}; mkdir -p "$STATE"
mac_ok(){ echo "$1"|grep -Eiq '^([0-9a-f]{2}:){5}[0-9a-f]{2}$'; }
mac_lc(){ echo "$1"|tr A-F a-f; }
base(){ echo "$STATE/$(mac_lc "$1")"; }
audit(){ printf '%s|%s|%s|%s|%s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$(mac_lc "$1")" "$2" "$3" "${4:-}" >> "$STATE/audit.log"; tail -n 200 "$STATE/audit.log" > "$STATE/.audit" && mv "$STATE/.audit" "$STATE/audit.log"; }
nft_init(){
 if ! nft list table inet bandwidth_control 2>/dev/null | grep -q 'priority filter - 1'; then
  nft delete table inet bandwidth_control 2>/dev/null || true
  nft -f - <<'EOF'
table inet bandwidth_control {
 set blocked_macs { type ether_addr; flags interval; }
 chain forward { type filter hook forward priority filter - 1; policy accept; ether saddr @blocked_macs drop; }
}
EOF
  for f in "$STATE"/*.blocked; do [ -e "$f" ] || continue; mac=${f##*/}; mac=${mac%.blocked}; nft add element inet bandwidth_control blocked_macs "{ $mac }" 2>/dev/null || true; done
 fi
}
raw(){ if [ -n "${BC_RAW:-}" ]; then printf '%s\n' "$BC_RAW"; else nlbw -c csv -g mac -o mac -q 2>/dev/null|awk -F '\t' -v m="$(mac_lc "$1")" 'tolower($1)==m {rx+=$3;tx+=$5} END{print rx+0 "|" tx+0 "|" rx+tx+0}'; fi; }
calc_usage(){
 awk -F'|' -v r="$1" -v o="$2" -v t="$3" 'BEGIN{split(r,x,"|");split(o,y,"|");split(t,z,"|");for(i=1;i<=3;i++){d=x[i]-y[i];if(d<0)d=x[i];printf "%.0f%s",z[i]+d,i==3?"\n":"|"}}'
}
sync(){
 mac=$(mac_lc "$1"); b=$(base "$mac"); r=$(raw "$mac")
 if [ ! -f "$b.used" ]; then
  old=$(cat "$b.baseline" 2>/dev/null || echo '0|0|0')
  awk -F'|' -v r="$r" -v o="$old" 'BEGIN{split(r,x,"|");split(o,y,"|");for(i=1;i<=3;i++){d=x[i]-y[i];if(d<0)d=0;printf "%.0f%s",d,i==3?"\n":"|"}}' > "$b.used"
  printf '%s\n' "$r" > "$b.last_raw"; return
 fi
 old=$(cat "$b.last_raw" 2>/dev/null || cat "$b.baseline" 2>/dev/null || echo '0|0|0'); total=$(cat "$b.used")
 calc_usage "$r" "$old" "$total" > "$b.used"
 printf '%s\n' "$r" > "$b.last_raw"
}
migrate(){
 mac=$(mac_lc "$1"); b=$(base "$mac"); total=$(cat "$b.used" 2>/dev/null || echo '0|0|0'); raw_now=$(raw "$mac")
 if [ ! -f "$b.baseline" ]; then
  # Old state without a reset baseline: raw nlbwmon counters are the only safe full-period source.
  printf '%s\n' "$raw_now" > "$b.used"
 else
  baseval=$(cat "$b.baseline")
  awk -F'|' -v r="$raw_now" -v b="$baseval" -v t="$total" 'BEGIN{split(r,x,"|");split(b,y,"|");split(t,z,"|");for(i=1;i<=3;i++){if(z[i]>=2147483647){d=x[i]-y[i];if(d<0)d=x[i];z[i]=d}printf "%.0f%s",z[i],i==3?"\n":"|"}}' > "$b.used"
 fi
 printf '%s\n' "$raw_now" > "$b.last_raw"
 audit "$mac" migrate overflow
}
migrate_all(){
 uci show bandwidth-control 2>/dev/null | sed -n 's/^bandwidth-control\.\([^.=]*\)=device$/\1/p' | while read -r s; do
  mac=$(uci -q get "bandwidth-control.$s.mac" 2>/dev/null || true)
  [ -n "$mac" ] && migrate "$mac"
 done
}
usage(){ mac=$(mac_lc "$1"); sync "$mac"; cat "$(base "$mac").used"; }
used(){ usage "$1"|awk -F'|' '{print $3}'; }
group_usage(){
 rows=""; for mac in "$@"; do rows="$rows$(usage "$mac")\n"; done
 printf '%b' "$rows" | awk -F'|' '{rx+=$1;tx+=$2;total+=$3} END{printf "%.0f|%.0f|%.0f\n",rx,tx,total}'
}
reset(){ mac=$(mac_lc "$1"); r=$(raw "$mac"); b=$(base "$mac"); printf '%s\n' "$r" > "$b.baseline"; printf '0|0|0\n' > "$b.used"; printf '%s\n' "$r" > "$b.last_raw"; date +%s > "$b.reset_at"; [ "$(cat "$b.reason" 2>/dev/null || true)" = quota ] && unblock "$mac"; audit "$mac" reset manual; }
history(){ mac=$(mac_lc "$1"); leases | awk -F'|' -v m="$mac" '$1==m{print $2 "|" $3}' | while IFS='|' read ip host; do printf '%s\n' "$ip" > "$(base "$mac").ip"; printf '%s\n' "$host" > "$(base "$mac").host"; date '+%Y-%m-%d %H:%M:%S' > "$(base "$mac").last_seen"; done; }
rolling(){ mac=$(mac_lc "$1"); days=${2:-0}; case "$days" in ''|*[!0-9]*) return;; esac; [ "$days" -gt 0 ] || return; at=$(cat "$(base "$mac").reset_at" 2>/dev/null || echo 0); [ $(( $(date +%s) - at )) -ge $((days*86400)) ] && reset "$mac"; }
block(){ mac=$(mac_lc "$1"); why=${2:-manual}; mac_ok "$mac"||exit 2; nft_init; nft add element inet bandwidth_control blocked_macs "{ $mac }" 2>/dev/null||true; :>"$(base "$mac").blocked"; printf '%s\n' "$why">"$(base "$mac").reason"; date '+%Y-%m-%d %H:%M:%S'>"$(base "$mac").at"; audit "$mac" block "$why"; }
unblock(){ mac=$(mac_lc "$1"); mac_ok "$mac"||exit 2; nft_init; nft delete element inet bandwidth_control blocked_macs "{ $mac }" 2>/dev/null||true; rm -f "$(base "$mac").blocked" "$(base "$mac").reason" "$(base "$mac").at"; audit "$mac" unblock manual; }
status(){ b=$(base "$1"); [ -f "$b.blocked" ]&&printf 'blocked|%s|%s\n' "$(cat "$b.reason")" "$(cat "$b.at")"||printf 'allowed||\n'; }
leases(){ awk 'NF>=4{h=$4;if(h=="*")h="unknown";print tolower($2)"|"$3"|"h}' "${BC_LEASES:-/tmp/dhcp.leases}" 2>/dev/null; }
quota(){ q=$(printf %s "$1"|tr , .); echo "$q"|grep -Eq '^(0|[1-9][0-9]*)(\.[0-9]+)?$'||return 2; awk -v q="$q" 'BEGIN{printf "%.0f\n",q*1073741824}'; }
at_least(){ awk -v used="$1" -v limit="$2" 'BEGIN{exit !(used+0 >= limit+0)}'; }
check_dev(){ s=$1; mac=$(uci -q get bandwidth-control.$s.mac)||return; [ "$(uci -q get bandwidth-control.$s.enabled||echo 1)" = 1 ]||return; history "$mac"; rolling "$mac" "$(uci -q get bandwidth-control.$s.rolling_days||echo 0)"; lim=$(quota "$(uci -q get bandwidth-control.$s.quota_gb||echo 0)")||return; at_least "$(used "$mac")" "$lim" && block "$mac" quota; }
check_group(){ s=$1; [ "$(uci -q get bandwidth-control.$s.enabled||echo 1)" = 1 ]||return; lim=$(quota "$(uci -q get bandwidth-control.$s.quota_gb||echo 0)")||return; macs=$(uci -q get bandwidth-control.$s.mac 2>/dev/null||true); [ -n "$macs" ]||return; total=$(group_usage $macs | awk -F'|' '{print $3}'); at_least "$total" "$lim" && for mac in $macs;do block "$mac" quota-group;done; }
check(){ [ "$(uci -q get bandwidth-control.main.enabled||echo 0)" = 1 ]||return; nft_init; uci show bandwidth-control|sed -n 's/^bandwidth-control\.\([^.=]*\)=device$/\1/p'|while read s;do check_dev "$s";done; uci show bandwidth-control|sed -n 's/^bandwidth-control\.\([^.=]*\)=group$/\1/p'|while read s;do check_group "$s";done; }
case "${1:-check}" in check)check;;sync)sync "$2";;migrate)migrate "$2";;migrate-all)migrate_all;;block)block "$2" "${3:-manual}";;unblock)unblock "$2";;reset)reset "$2";;used)used "$2";;usage)usage "$2";;group-usage)shift; group_usage "$@";;status)status "$2";;leases)leases;;history)history "$2";;quota-bytes)quota "$2";;audit)tail -n "${2:-50}" "$STATE/audit.log" 2>/dev/null||true;;*)exit 2;;esac
